{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/invite-preview.js": {
            "includeFiles": "dist/index.html"
        }
    },
    "rewrites": [
        {
            "source": "/:slug/invite/:guestCode",
            "destination": "/api/invite-preview?slug=:slug&guestCode=:guestCode"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
